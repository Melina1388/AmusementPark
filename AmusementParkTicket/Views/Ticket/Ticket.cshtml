@{
    ViewData["Title"] = "وضعیت بلیط";
}
@section Styles {
    <link rel="stylesheet" href="~/css/Ticket.css" />
}

@section Scripts {
    <script src="~/js/Ticket.js"></script>
}

<partial name="_Header" />

<div class="wrap">

    <div class="search-box">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#a79fc7" stroke-width="2"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
        <input type="text" id="searchInput" placeholder="جستجو با کد پیگیری...">
    </div>

    <div class="tabs">
        <button class="tab-btn active" data-tab="unused">استفاده‌نشده <span class="count" id="countUnused">0</span></button>
        <button class="tab-btn" data-tab="used">استفاده‌شده <span class="count" id="countUsed">0</span></button>
        <button class="tab-btn" data-tab="cancelled">لغوشده <span class="count" id="countCancelled">0</span></button>
    </div>

    <div class="tab-panel active" data-panel="unused" id="panelUnused"></div>
    <div class="tab-panel" data-panel="used" id="panelUsed"></div>
    <div class="tab-panel" data-panel="cancelled" id="panelCancelled"></div>
</div>

<div class="modal-overlay" id="qrConfirmModal">
    <div class="modal-box">
        <div class="modal-icon">🔍</div>
        <h3>مشاهده‌ی QR کد بلیط</h3>
        <p>آیا از دیدن QR کد اطمینان دارید؟ بعد از مشاهده‌ی آن، این بلیط به بخش «استفاده‌شده‌ها» منتقل می‌شود.</p>
        <div class="modal-actions">
            <button class="modal-btn-cancel" id="qrCancelBtn">انصراف</button>
            <button class="modal-btn-confirm" id="qrConfirmBtn">بله، نمایش بده</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="qrShowModal">
    <div class="modal-box">
        <h3>بلیط شما آماده‌ست 🎟️</h3>
        <div class="qr-box" id="qrBox"></div>
        <p style="margin-bottom:6px;">این QR کد رو موقع ورود به شهربازی نشون بده.</p>
        <div class="modal-actions">
            <button class="modal-btn-confirm" id="qrCloseBtn" style="flex:none; width:100%;">متوجه شدم</button>
        </div>
    </div>
</div>

<div class="modal-overlay" id="cancelConfirmModal">
    <div class="modal-box">
        <div class="modal-icon">⚠️</div>
        <h3>لغو این بلیط؟</h3>
        <p>با تایید لغو، مبلغ بلیط طبق مشخصات زیر بازگشت داده می‌شود:</p>
        <div class="refund-card">
            <div class="row"><span>نام خریدار</span><b id="refundName">—</b></div>
            <div class="row"><span>شماره کارت</span><b id="refundCard">—</b></div>
            <div class="row"><span>مبلغ بازگشتی</span><b id="refundAmount">—</b></div>
        </div>
        <div class="modal-actions">
            <button class="modal-btn-cancel" id="cancelDismissBtn">منصرف شدم</button>
            <button class="modal-btn-confirm" id="cancelConfirmBtn">تایید لغو بلیط</button>
        </div>
    </div>
</div>
