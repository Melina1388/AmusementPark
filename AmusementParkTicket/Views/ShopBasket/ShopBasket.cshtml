@model List<AmusementPark.Application.DTOs.ShopBasketItemDto>

<partial name="_Background" />

<partial name="_Header" />


<div class="cart-wrap" id="cartWrap">

    <h1 class="page-title">🛒 سبد خرید</h1>

    @if (Model == null || !Model.Any())
    {
        <div class="cart-empty">
            <div class="big-emoji">🛒</div>

            <h2>سبد خرید شما خالی است</h2>

            <a asp-controller="Home"
               asp-action="Home"
               class="submit-btn"
               style="text-decoration:none;">
                بازگشت به فروشگاه
            </a>
        </div>
    }
    else
    {
        @foreach (var group in Model.GroupBy(x => x.AmusementName))
        {
            <section class="cart-park-group">

                <h2 class="cart-park-title">
                    <span class="emoji-spin">🎡</span>
                    @group.Key
                </h2>

                @foreach (var item in group)
                {
                    <div class="cart-row">

                        <div class="cart-row-icon">
                            🎫
                        </div>

                        <div class="cart-row-info">

                            <p class="ride-name">
                                @item.GameName
                            </p>

                            <span class="unit-price">
                                @item.GamePrice.ToString("N0")
                                تومان / بلیط
                            </span>

                        </div>


                        <div class="qty-stepper">

                            <form asp-action="Decrease"
                                  method="post">

                                <input type="hidden"
                                       name="gameId"
                                       value="@item.GameID" />

                                <button type="submit"
                                        class="qty-btn">
                                    −
                                </button>

                            </form>


                            <span class="qty-value">
                                @item.Quantity
                            </span>


                            <form asp-action="Increase"
                                  method="post">

                                <input type="hidden"
                                       name="gameId"
                                       value="@item.GameID" />

                                <button type="submit"
                                        class="qty-btn">
                                    +
                                </button>

                            </form>

                        </div>


                        <div class="line-total">

                            @item.TotalPrice.ToString("N0")

                            تومان

                        </div>


                        <form asp-action="Remove"
                              method="post">

                            <input type="hidden"
                                   name="gameId"
                                   value="@item.GameID" />

                            <button type="submit"
                                    class="remove-btn"
                                    aria-label="حذف">

                                🗑️

                            </button>

                        </form>

                    </div>
                }

            </section>
        }
    }

</div>


@if (Model != null && Model.Any())
{
    decimal total =
        Model.Sum(x => x.TotalPrice);


    <div class="cart-total-bar">

        <div>

            <div class="total-label">
                مجموع سبد خرید
            </div>

            <div class="total-value">

                @total.ToString("N0")

                تومان

            </div>

        </div>


        <a asp-controller="Payment"
           asp-action="Payment"
           class="checkout-btn">

            پرداخت

        </a>

    </div>
}