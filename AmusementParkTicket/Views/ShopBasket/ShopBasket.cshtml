
<header>
    <div class="logo"><span class="bulb"></span> بلیط<span class="dot">شهربازی</span></div>
</header>

<div class="cart-wrap" id="cartWrap">
    <h1 class="page-title">🛒 سبد خرید</h1>

    <section class="cart-park-group" data-park-group>
        <h2 class="cart-park-title"><span class="emoji-spin">🎡</span> شهربازی ارم</h2>

        <div class="cart-row" data-cart-row data-unit-price="180000" data-quantity="2">
            <div class="cart-row-icon">🎫</div>
            <div class="cart-row-info"><p class="ride-name">ترن هوایی</p><span class="unit-price">۱۸۰,۰۰۰ تومان / بلیط</span></div>
            <div class="qty-stepper">
                <button type="button" class="qty-btn" data-qty-decrease>−</button>
                <span class="qty-value" data-qty-value>2</span>
                <button type="button" class="qty-btn" data-qty-increase>+</button>
            </div>
            <div class="line-total" data-line-total>360,000</div>
        </div>

        <div class="cart-row" data-cart-row data-unit-price="90000" data-quantity="1">
            <div class="cart-row-icon">🎫</div>
            <div class="cart-row-info"><p class="ride-name">چرخ و فلک</p><span class="unit-price">۹۰,۰۰۰ تومان / بلیط</span></div>
            <div class="qty-stepper">
                <button type="button" class="qty-btn" data-qty-decrease>−</button>
                <span class="qty-value" data-qty-value>1</span>
                <button type="button" class="qty-btn" data-qty-increase>+</button>
            </div>
            <div class="line-total" data-line-total>90,000</div>
        </div>
    </section>

    <section class="cart-park-group" data-park-group>
        <h2 class="cart-park-title"><span class="emoji-spin">🎡</span> شهربازی بسیج</h2>

        <div class="cart-row" data-cart-row data-unit-price="140000" data-quantity="3">
            <div class="cart-row-icon">🎫</div>
            <div class="cart-row-info"><p class="ride-name">قطار وحشت</p><span class="unit-price">۱۴۰,۰۰۰ تومان / بلیط</span></div>
            <div class="qty-stepper">
                <button type="button" class="qty-btn" data-qty-decrease>−</button>
                <span class="qty-value" data-qty-value>3</span>
                <button type="button" class="qty-btn" data-qty-increase>+</button>
            </div>
            <div class="line-total" data-line-total>420,000</div>
        </div>
    </section>
</div>

<div class="cart-total-bar" id="totalBar">
    <div>
        <div class="total-label">مجموع سبد خرید</div>
        <div class="total-value"><span data-grand-total>870,000</span> تومان</div>
    </div>
    <a class="checkout-btn" href="#">پرداخت</a>
</div>
