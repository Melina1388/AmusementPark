@model AmusementPark.Web.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "خانه";
}
@section Styles {
    <link rel="stylesheet" href="~/css/Home.css" />
}

@section Scripts {
    <script src="~/js/Home.js"></script>
}
<partial name="_Background" />

<partial name="_Header" />


<!-- ===== جستجو ===== -->
<div class="search-wrap">

    <form id="searchForm"
          asp-controller="Home"
          asp-action="Home"
          method="get">

        <div class="search-box">

            <svg width="18"
                 height="18"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="#a79fc7"
                 stroke-width="2">

                <circle cx="11"
                        cy="11"
                        r="7" />

                <line x1="21"
                      y1="21"
                      x2="16.65"
                      y2="16.65" />

            </svg>


            <input id="searchInput"
                   type="text"
                   name="search"
                   autocomplete="off"
                   placeholder="جستجوی نام شهربازی یا بازی مورد نظر..." />

        </div>


        <div id="searchSuggestions"
             class="search-suggestions">
        </div>

    </form>

</div>

<div id="ticket-success-modal"
     class="ticket-message-overlay hidden">

    <div class="ticket-message-box">

        <button type="button"
                id="close-ticket-message"
                class="ticket-message-close">
            ×
        </button>

        <div class="ticket-message-icon">
            ✓
        </div>


        <p>
            بلیت شما به سبد خرید اضافه شد.
        </p>

        <a href="/ShopBasket/ShopBasket"
           class="ticket-message-cart-link">
            مشاهده سبد خرید
        </a>

    </div>

</div>
@Html.AntiForgeryToken()
<!-- ===== بخش‌های شهربازی ===== -->
<main id="parksContainer">

    @if (!string.IsNullOrWhiteSpace(
    Context.Request.Query["search"]) &&
    !Model.Games.Any())
    {
        <div class="search-empty">

            <div class="search-empty-icon">
                🔎
            </div>

            <h2>
                موردی پیدا نشد
            </h2>

            <p>
                برای
                <strong>
                    «@Context.Request.Query["search"]»
                </strong>
                نتیجه‌ای پیدا نکردیم.
            </p>

            <a asp-controller="Home"
               asp-action="Home"
               class="search-empty-button">
                نمایش همه بازی‌ها
            </a>

        </div>
    }
    else
    {
        @foreach (var amusement in Model.Amusements)
        {
            <section class="park-section">

                <div class="park-title-row">

                    <h2>
                        @amusement.AmusementName
                    </h2>

                </div>

                <div class="ride-row">

                    @foreach (var game in amusement.Games)
                    {
                        <div class="ride-card">

                            <div class="thumb">

                                @if (!string.IsNullOrWhiteSpace(
                               game.GamePic))
                                {
                                    <img src="@game.GamePic"
                                         alt="@game.GameName"
                                         loading="lazy" />
                                }

                            </div>

                            <div class="info">

                                <p class="name">
                                    @game.GameName
                                </p>

                                @if (game.GamePrice.HasValue)
                                {
                                    <span class="price">
                                        @game.GamePrice.Value.ToString("N0")
                                        تومان
                                    </span>
                                }

                                @if (!string.IsNullOrWhiteSpace(
                               game.GameComment))
                                {
                                    <p class="comment">
                                        @game.GameComment
                                    </p>
                                }

                            </div>
                            @{
                                int currentQuantity = 0;

                                if (game.GameID.HasValue)
                                {
                                    Model.BasketQuantities.TryGetValue(
                                    game.GameID.Value,
                                    out currentQuantity);
                                }
                            }

                            <div class="ticket-counter"
                                 data-game-id="@game.GameID"
                                 data-initial-quantity="@currentQuantity">

                                <button type="button"
                                        class="ticket-toggle"
                                        aria-expanded="false"
                                        data-game-id="@game.GameID">

                                    🎟️ انتخاب بلیط

                                </button>

                                <div class="ticket-controls">

                                    <button type="button"
                                            class="ticket-minus">
                                        −
                                    </button>

                                    <span class="ticket-count">
                                        @currentQuantity
                                    </span>

                                    <button type="button"
                                            class="ticket-plus">
                                        +
                                    </button>

                                </div>

                            </div>

                        </div>
                    }

                </div>

            </section>
        }
    }

</main>

<partial name="_Footer" />
